{
	"name": "key",
	"private": true,
	"type": "module",
	"scripts": {
		"key": "node src/main.ts",
		"serve": "node --watch-path=src --watch-preserve-output src/main.ts serve",
		"check": "biome check && tsc",
		"fix": "biome check --write",
		"lint": "biome lint",
		"format": "biome format --write",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	}
}
