{
  "name": "key",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node src/main.ts serve",
    "client": "node --experimental-eventsource src/main.ts client",
    "check": "biome check && tsc",
    "fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "link:../pi/packages/ai",
    "@earendil-works/pi-durable": "link:../pi/packages/durable",
    "@earendil-works/pi-tui": "1.4.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
